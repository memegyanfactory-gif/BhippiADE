* text=auto

*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Godot writes LF and Bhippi's parsers assert byte-identical round-trips against these
# fixtures, so a CRLF checkout on Windows would fail the tests for no real reason.
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.import text eol=lf
*.gdextension text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.glb binary
*.gltf text eol=lf

# Markdown may use two-space hard breaks; IPC is generated verbatim.
*.md whitespace=-trailing-space
ui/src/lib/ipc.ts -whitespace
