# Rust
/target/
**/target/

# Frontend
/ui/node_modules/
/ui/.npm-cache/
/ui/dist/

# Tauri-generated output
/crates/bhippi-app/gen/

# The bundled Godot (ADR-0047): fetched by scripts/fetch-godot.mjs, never committed. The
# directory itself stays, so the bundle glob resolves in a fresh checkout.
/crates/bhippi-app/resources/godot/*
!/crates/bhippi-app/resources/godot/README.md

# Local runtime state and databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Credentials and signing material
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Editors and operating systems
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local agent/workspace state (never publish)
/.rsh/
/.tmp-codex-schema/
/scratch/
/.mcp.json
/opencode.json
/AGENTS.md
/CLAUDE.md

# Local planning, handoff and agent documentation. Keep product-facing and runtime Markdown only.
/docs/
*.md
!README.md
!CONTRIBUTING.md
!SECURITY.md
!prompts/*.md
!prompts/design/**/*.md
!ui/THIRD_PARTY_NOTICES.md

# Local QA and coverage output
/.qa/
/coverage/
**/.bhippi/reports/
*.lcov
/harness.png
