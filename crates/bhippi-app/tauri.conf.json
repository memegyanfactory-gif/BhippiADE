{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bhippi",
  "version": "0.1.0",
  "identifier": "app.bhippi.desktop",
  "build": {
    "beforeBuildCommand": "npm run build --prefix ../../ui",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "bhippi",
        "label": "main",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
