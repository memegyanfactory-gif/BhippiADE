{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bhippi",
  "version": "1.2.0",
  "identifier": "app.bhippi.desktop",
  "build": {
    "beforeBuildCommand": "node ../scripts/build-ui.mjs && node ../scripts/fetch-godot.mjs",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "bhippi",
        "label": "main",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "worker-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost https: http:",
        "img-src": "'self' asset: http://asset.localhost blob: data: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' blob: data: https: http:",
        "frame-src": "https: http:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/godot/*",
      "resources/licenses/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
