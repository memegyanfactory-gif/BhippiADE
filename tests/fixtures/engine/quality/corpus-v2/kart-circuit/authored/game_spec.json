  "acceptance_mechanics": [
    {
      "id": "mech_drift_charges_boost",
      "promise": "Holding the handbrake through a corner slides the kart and charges a boost.",
      "setup": [
        "Place the kart at the entry of the first corner at cruising speed",
        "Disable every rival"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_drift",
        "req_level"
      ],
      "deterministic_probes": [
        "Hold the drift input through the corner and sample the slip angle",
        "Release the drift and sample speed over the next second"
      ],
      "expected_evidence": [
        "The slip angle rises while the drift input is held",
        "Lateral grip drops to drift_grip during the slide",
        "Speed after release exceeds the pre-drift speed by boost_power"
      ]
    },
    {
      "id": "mech_laps_count_in_order",
      "promise": "A lap counts only when every checkpoint is taken in order.",
      "setup": [
        "Set lap_count and checkpoint_count to their authored values",
        "Start the kart on the grid"
      ],
      "requirement_ids": [
        "req_rules",
        "req_hud",
        "req_level"
      ],
      "deterministic_probes": [
        "Drive the full circuit and read the lap counter",
        "Skip one checkpoint, cross the line and read the lap counter",
        "Complete lap_count valid laps and read the race result"
      ],
      "expected_evidence": [
        "A complete circuit increments the lap counter by one",
        "A circuit with a skipped checkpoint does not increment it",
        "The race result is raised on the final valid lap"
      ]
    }
