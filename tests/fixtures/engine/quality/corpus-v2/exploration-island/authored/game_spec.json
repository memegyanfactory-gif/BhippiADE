        "Load the first island pair with the authored gap_distance",
        "Place the player on the launch edge facing the far island"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_glide",
        "req_level"
      ],
      "deterministic_probes": [
        "Jump, hold the glide input and sample vertical speed every frame",
        "Record the horizontal distance travelled before the player lands"
      ],
      "expected_evidence": [
        "Vertical speed while gliding equals glide_fall_speed within tolerance",
        "Glide duration never exceeds glide_time",
        "The landing point is on the far island collider"
      ]
    },
