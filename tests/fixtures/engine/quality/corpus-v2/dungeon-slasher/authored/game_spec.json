    {
      "id": "mech_dash_grants_escape",
      "promise": "A dash covers more ground than a walk and cannot be spammed.",
      "setup": [
        "Load one arena room with the player at its centre",
        "Freeze every enemy"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_dash",
        "req_level"
      ],
      "deterministic_probes": [
        "Walk for one second and record the distance",
        "Dash and record the distance",
        "Request a second dash immediately and record whether it fires"
      ],
      "expected_evidence": [
        "The dash distance exceeds the walked distance",
        "The second dash is refused until dash_cooldown has elapsed",
        "The player collider never leaves the arena bounds"
      ]
    },
    {
      "id": "mech_room_clears_on_last_enemy",
      "promise": "The room reports cleared exactly when the last enemy dies, and not before.",
      "setup": [
        "Spawn the authored chaser count in one room",
        "Give the player unlimited health"
      ],
      "requirement_ids": [
        "req_rules",
        "req_actor_chaser",
        "req_hud"
      ],
      "deterministic_probes": [
        "Kill every enemy but one and read the room state",
        "Kill the last enemy and read the room state and HUD score"
      ],
      "expected_evidence": [
        "The room state stays uncleared while one enemy lives",
        "The room reports cleared once, on the final kill",
        "The HUD score rises by the authored amount per kill"
      ]
    }
