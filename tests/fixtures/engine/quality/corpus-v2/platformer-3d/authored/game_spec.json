  "acceptance_mechanics": [
    {
      "id": "mech_jump_arc_clears_the_gap",
      "promise": "A single jump clears the authored gap and a double jump clears the long one.",
      "setup": [
        "Load the tutorial course with its authored gap_distance",
        "Place the player at the first launch pad"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_double_jump",
        "req_level"
      ],
      "deterministic_probes": [
        "Jump once and record the apex height and landing point",
        "Jump, then jump again at apex, and record the second landing point"
      ],
      "expected_evidence": [
        "The single-jump apex matches jump_velocity and gravity within tolerance",
        "The single jump lands on the short platform",
        "The double jump lands on the long platform"
      ]
    },
    {
      "id": "mech_checkpoint_restores_progress",
      "promise": "Dying after a checkpoint respawns at that checkpoint with the coins already taken.",
      "setup": [
        "Load the course with checkpoint_count checkpoints",
        "Collect two coins and touch the second checkpoint"
      ],
      "requirement_ids": [
        "req_system_checkpoints",
        "req_hud",
        "req_rules"
      ],
      "deterministic_probes": [
        "Kill the player in the next hazard",
        "Read the respawn transform and the coin counter"
      ],
      "expected_evidence": [
        "The respawn transform equals the second checkpoint marker",
        "The coin counter still reads two",
        "The HUD life or checkpoint readout updates once"
      ]
    }
  ],
