  "acceptance_mechanics": [
    {
      "id": "mech_hitscan_registers_damage",
      "promise": "A shot down the crosshair takes exactly the authored damage off the target.",
      "setup": [
        "Place one stationary bot at a fixed distance in the arena",
        "Fill the player magazine to ammo_capacity"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_shoot_hitscan",
        "req_actor_bot"
      ],
      "deterministic_probes": [
        "Fire one shot aimed at the bot centre and read its health",
        "Fire one shot deliberately wide and read its health",
        "Fire until the magazine empties and read the ammo counter"
      ],
      "expected_evidence": [
        "The centred shot removes exactly damage health",
        "The wide shot removes none",
        "The ammo counter reaches zero after ammo_capacity shots and refuses to fire"
      ]
    },
    {
      "id": "mech_frag_limit_ends_match",
      "promise": "The match ends the moment a player reaches the frag target.",
      "setup": [
        "Set score_target to a small value",
        "Spawn the authored bot count"
      ],
      "requirement_ids": [
        "req_rules",
        "req_hud"
      ],
      "deterministic_probes": [
        "Kill bots one at a time and read the HUD frag tally",
        "Read the match state on the kill that reaches score_target"
      ],
      "expected_evidence": [
        "The frag tally rises by one per kill",
        "The match reports finished exactly on the target kill",
        "No respawn or further scoring happens after the match ends"
      ]
    }
