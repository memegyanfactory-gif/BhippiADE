  "acceptance_mechanics": [
    {
      "id": "mech_grab_carry_throw",
      "promise": "A crate inside reach can be grabbed, carried without clipping, and thrown.",
      "setup": [
        "Place one crate at grab_range from the player",
        "Place a second crate beyond grab_range"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_grab_throw",
        "req_prop_physics_crate"
      ],
      "deterministic_probes": [
        "Aim at the near crate and grab, then read the held body",
        "Walk one metre and sample the crate transform each frame",
        "Aim at the far crate and grab, then read the held body",
        "Throw the held crate and record its landing point"
      ],
      "expected_evidence": [
        "The near crate becomes the held body and the far crate does not",
        "The carried crate never intersects the level collider",
        "The thrown crate leaves with throw_force and comes to rest"
      ]
    },
    {
      "id": "mech_plate_opens_door",
      "promise": "A plate holds its door open only while enough mass rests on it.",
      "setup": [
        "Load one room with a plate, a door and a crate heavier than required_mass",
        "Leave the door closed"
      ],
      "requirement_ids": [
        "req_prop_pressure_plate",
        "req_rules",
        "req_level"
      ],
      "deterministic_probes": [
        "Place the crate on the plate and read the door state",
        "Lift the crate off the plate and read the door state",
        "Solve every room and read the run result"
      ],
      "expected_evidence": [
        "The door opens while the crate rests on the plate",
        "The door closes when the plate is cleared",
        "The run result is a win once every room reports solved"
      ]
    }
