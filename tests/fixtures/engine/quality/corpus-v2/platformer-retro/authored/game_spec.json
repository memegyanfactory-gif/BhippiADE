      "id": "mech_variable_jump_height",
      "promise": "Tapping jump gives a short hop and holding it gives the full arc.",
      "setup": [
        "Load the first course at the spawn tile",
        "Freeze enemies so only the player moves"
      ],
      "requirement_ids": [
        "req_player",
        "req_ability_double_jump"
      ],
      "deterministic_probes": [
        "Tap jump for one frame and record the apex",
        "Hold jump to the top of the arc and record the apex",
        "Step off a ledge and jump inside the coyote window"
      ],
      "expected_evidence": [
        "The tapped apex is strictly lower than the held apex",
        "The held apex matches jump_velocity and gravity within tolerance",
        "The coyote jump succeeds inside coyote_time and fails after it"
      ]
    },
    {
      "id": "mech_lives_end_the_run",
      "promise": "Each death spends one life and the run ends at zero.",
      "setup": [
        "Set lives to its authored value",
        "Place a hazard directly under the spawn"
      ],
      "requirement_ids": [
        "req_system_lives",
        "req_hud",
        "req_rules"
      ],
      "deterministic_probes": [
        "Kill the player once and read the HUD life count",
        "Repeat until the count reaches zero",
        "Read the run result after the final death"
      ],
      "expected_evidence": [
        "The HUD life count decreases by exactly one per death",
        "The run result is a loss on the death that reaches zero",
        "No respawn happens after the run result is raised"
      ]
    }
