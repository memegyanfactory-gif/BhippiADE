  "acceptance_mechanics": [
    {
      "id": "mech_chunks_stream_without_a_seam",
      "promise": "Corridor chunks recycle ahead of the player with no gap and no visible pop.",
      "setup": [
        "Start a run at the authored speed",
        "Pin the camera to the runner chase offset"
      ],
      "requirement_ids": [
        "req_level",
        "req_player"
      ],
      "deterministic_probes": [
        "Run for ten chunk_length units and sample the ground collider each frame",
        "Record every chunk spawn and despawn position"
      ],
      "expected_evidence": [
        "The ground collider is continuous for the whole sample",
        "Every despawn happens behind the camera frustum",
        "Chunk spawn positions are exactly chunk_length apart"
      ]
    },
    {
      "id": "mech_hazard_ends_the_run",
      "promise": "Hitting a hazard ends the run and banks the distance as the score.",
      "setup": [
        "Place one hazard in the centre lane",
        "Clear every collectible from the first chunk"
      ],
      "requirement_ids": [
        "req_rules",
        "req_hud",
        "req_obstacle_runner_hazard"
      ],
      "deterministic_probes": [
        "Run into the hazard and read the run state and HUD score",
        "Run a second time, change lane to avoid it, and read the run state",
        "Sweep a coin line and read the multiplier"
      ],
      "expected_evidence": [
        "Contact with the hazard raises the run-over result once",
        "Avoiding the hazard leaves the run active",
        "The banked score equals the distance times the multiplier"
      ]
    }
