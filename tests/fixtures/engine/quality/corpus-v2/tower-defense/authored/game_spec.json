  "acceptance_mechanics": [
    {
      "id": "mech_tower_costs_and_fires",
      "promise": "Placing a tower spends its cost and the tower only fires inside its range.",
      "setup": [
        "Set the build purse to exactly build_cost",
        "Send one creep down the lane"
      ],
      "requirement_ids": [
        "req_ability_build_tower",
        "req_tower_gun_turret",
        "req_actor_creep"
      ],
      "deterministic_probes": [
        "Place one tower on a build slot and read the purse",
        "Attempt a second placement and read the purse and slot state",
        "Sample the tower's target while the creep is outside and inside attack_range"
      ],
      "expected_evidence": [
        "The purse falls by build_cost on the first placement",
        "The second placement is refused and the purse is unchanged",
        "The tower acquires the creep only inside attack_range and fires at fire_rate"
      ]
    },
    {
      "id": "mech_leak_damages_base",
      "promise": "A creep that reaches the base costs base health, and zero health ends the run.",
      "setup": [
        "Place no towers",
        "Set base health to a small value"
      ],
      "requirement_ids": [
        "req_rules",
        "req_hud",
        "req_enemy_wave_spawner"
      ],
      "deterministic_probes": [
        "Release one wave and read the base health after the first leak",
        "Let the base health reach zero and read the run result",
        "Clear every wave in a second run and read the run result"
      ],
      "expected_evidence": [
        "Base health falls by one per leaked creep",
        "The run reports a loss when base health reaches zero",
        "Surviving wave_count waves reports a win"
      ]
    }
