  "acceptance_mechanics": [
    {
      "id": "mech_meters_drain_and_refill",
      "promise": "Hunger drains on the clock, food refills it, and an empty meter costs health.",
      "setup": [
        "Start a run at full hunger and stamina",
        "Place one food resource within reach"
      ],
      "requirement_ids": [
        "req_system_hunger_stamina",
        "req_hud",
        "req_pickup_resource_node"
      ],
      "deterministic_probes": [
        "Advance the clock sixty seconds and read hunger",
        "Eat the food and read hunger",
        "Advance the clock until hunger empties and read health"
      ],
      "expected_evidence": [
        "Hunger falls at hunger_rate per second",
        "Eating raises hunger and never above its maximum",
        "Health falls only once hunger has reached zero"
      ]
    },
    {
      "id": "mech_night_brings_the_threat",
      "promise": "Stalkers appear only at night and stop spawning at dawn.",
      "setup": [
        "Set day_length to a short authored value",
        "Place the player in the open valley"
      ],
      "requirement_ids": [
        "req_system_day_night",
        "req_actor_stalker",
        "req_level"
      ],
      "deterministic_probes": [
        "Run a full day segment and count spawns",
        "Run a full night segment and count spawns",
        "Read the sun angle at each transition"
      ],
      "expected_evidence": [
        "No stalker spawns during the day segment",
        "Stalkers spawn during the night segment at spawn_interval",
        "The sun angle crosses the horizon exactly twice per day_length"
      ]
    }
